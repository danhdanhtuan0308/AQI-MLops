OWM_API_KEY=your_openweathermap_api_key
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# Redis Cloud connection string — get from Redis Cloud console > Connect > copy URL
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:your_password@your-host.redis.cloud:port

# =============================================================================
# Grafana Cloud Observability — direct push from FastAPI (no agents on EC2)
#
# Metrics: pushed via OTLP every 30s to Grafana Cloud Mimir
# Traces:  pushed via OTLP to Grafana Cloud Tempo
# Logs:    pushed via HTTP to Grafana Cloud Loki
#
# Get values at: Grafana Cloud → My Account → your stack → "Send data"
# =============================================================================

# Access Policy token (needs metrics:write + traces:write + logs:write scopes)
GRAFANA_API_KEY=glc_eyJ...

# OTLP gateway — used for BOTH metrics and traces
# Find at: Grafana Cloud → Connections → OpenTelemetry → Direct → Linux
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=123456

# Loki — logs (optional, leave blank to disable log shipping)
# Find at: Grafana Cloud → My Account → stack → Loki → Details
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=123456

# OTel service metadata
OTEL_SERVICE_NAME=aqi-api
OTEL_SERVICE_VERSION=1.0
