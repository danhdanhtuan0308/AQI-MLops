OWM_API_KEY=your_openweathermap_api_key
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# Redis Cloud connection string — get from Redis Cloud console > Connect > copy URL
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:your_password@your-host.redis.cloud:port

# =============================================================================
# Grafana Cloud Observability (Metrics → Mimir, Logs → Loki, Traces → Tempo)
# Grafana Cloud → My Account → your stack → "Details" for each signal type
# =============================================================================

# One Access Policy token (needs metrics:write + logs:write + traces:write scopes)
# Grafana Cloud → My Account → Security → Access Policies → Create token
GRAFANA_API_KEY=glc_eyJ...

# Prometheus / Mimir — "Prometheus" details panel
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_PROM_USER=123456

# Loki — "Loki" details panel
GRAFANA_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=123456

# Tempo — "Tempo" details panel  (include /otlp suffix)
GRAFANA_TEMPO_URL=https://tempo-prod-XX.grafana.net/tempo/otlp
GRAFANA_TEMPO_USER=123456

# OTel tracing — send spans from FastAPI to Alloy (docker-compose service name)
# Alloy listens on port 4318 (OTLP HTTP).  Leave blank to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_SERVICE_NAME=aqi-api
OTEL_SERVICE_VERSION=1.0
